<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>WorkforceDashboard</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.401" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Data\sample\*.csv" CopyToOutputDirectory="PreserveNewest" />
    <InternalsVisibleTo Include="WorkforceDashboard.Tests" />
  </ItemGroup>

</Project>
